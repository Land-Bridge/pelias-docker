{
  "logger": {
    "level": "info",
    "timestamp": false
  },
  "esclient": {
    "apiVersion": "7.5",
    "hosts": [
      {
        "host": "elasticsearch"
      }
    ]
  },
  "elasticsearch": {
    "settings": {
      "index": {
        "refresh_interval": "10s",
        "number_of_replicas": "0",
        "number_of_shards": "1"
      }
    }
  },
  "acceptance-tests": {
    "endpoints": {
      "docker": "http://api:4000/v1/"
    }
  },
  "api": {
    "targets": {
      "csv": ["address"]
    },
    "services": {
      "placeholder": {
        "url": "http://placeholder:4100"
      },
      "pip": {
        "url": "http://pip:4200"
      },
      "interpolation": {
        "url": "http://interpolation:4300"
      },
      "libpostal": {
        "url": "http://libpostal:4400"
      }
    },
    "defaultParameters": {
      "focus.point.lat": 47.6062,
      "focus.point.lon": -122.3321
    }
  },
  "imports": {
    "adminLookup": {
      "enabled": true
    },
    "csv": {
      "datapath": "/data/csv",
      "files": [],
      "download": ["parcels.csv"]
    },
    "geonames": {
      "datapath": "/data/geonames",
      "countryCode": "US",
      "importPlace": [
        102087539 
      ]
    },
    "openstreetmap": {
      "download": [
        {
          "sourceURL": "https://download.geofabrik.de/north-america/us/washington-latest.osm.pbf",
          "filename": "washington-latest.osm.pbf"
        }
      ],
      "leveldbpath": "/tmp",
      "datapath": "/data/openstreetmap",
      "import": [
        {
          "filename": "washington-latest.osm.pbf"
        }
      ]
    },
    "whosonfirst": {
      "datapath": "/data/whosonfirst",
      "importPostalcodes": true,
      "countryCode": "US",
      "importPlace": [
        "102087539"
      ]
    }
  },
  "interpolation": {
    "download": {
      "tiger": {
        "datapath": "/data/tiger",
        "states": [
          {
            "state_code": 53,
            "county_code": 33,
            "name": "King County, WA"
          }
        ]
      }
    }
  }
}